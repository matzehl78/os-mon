{
  "name": "osmon-schlupf-video",
  "private": true,
  "version": "1.0.0",
  "description": "3D-Video: Ei schlüpft, Figur wächst bis Erwachsen (Remotion + Three.js)",
  "scripts": {
    "sfx": "node scripts/make-sfx.mjs",
    "studio": "remotion studio",
    "render": "remotion render SchlupfVertikal out/schlupf-vertikal.mp4",
    "render:quadrat": "remotion render SchlupfQuadrat out/schlupf-quadrat.mp4",
    "still": "remotion still SchlupfVertikal out/thumbnail.png --frame=560",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/three": "4.0.542",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.542",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.187.0",
    "typescript": "^5.6.3"
  }
}
